# syntax=docker/dockerfile:1
# ======================================================================
# WPS 12 备用镜像（wps2pdf-wps12）
#   WPS Office 12.1.2.28080 + pywpsrpc 2.4.0
#
# 与主镜像（Dockerfile：WPS 11.1.0.9662 + pywpsrpc 1.1.0）的差异：
#   * WPS RPC SDK 库从 librpc*_sysqt5.so 改名 librpc*_wpsqt.so
#     （pywpsrpc 2.4.0 的 project.py 自动探测 _wpsqt 并链接）
#   * pywpsrpc 编译：sip 6.8.3 + `sip-build`（2.4.0 不再需要 sip 5.5 patch）
#   * WPS deb：官网动态签名下载（download_wps12.sh）或 WPS_DEB_URL build-arg
#
# 共享（不重复维护）：entrypoint.sh / http_server.py / convert_docx2pdf.py
#                     libexitfix.c / libmqsim.c / tests/e2e_test.sh
# 构建: docker build -f Dockerfile.wps12 -t wps2pdf-wps12 .
# WPS deb 来源（二选一）:
#   默认     : download_wps12.sh 从官网 wpscdn 动态签名下载（需外网）
#   --build-arg WPS_DEB_URL=https://github.com/<owner>/<repo>/releases/download/<tag>/wps-office_12.1.2.28080.AK.preread.sw.Personal_765474_amd64.deb
# ======================================================================

# ----------------------------------------------------------------------
# 阶段 1：编译 pywpsrpc 2.4.0 + 两个 LD_PRELOAD 修复库
# ----------------------------------------------------------------------
FROM ubuntu:24.04 AS builder

# WPS 12 deb URL（可选；留空则用 download_wps12.sh 从官网拉取）
ARG WPS_DEB_URL=""

ENV DEBIAN_FRONTEND=noninteractive

# 统一走阿里云镜像源（国内构建快，GitHub 境外 runner 实测也可达）
RUN sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' \
        /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential python3-dev python3-pip qt5-qmake qtbase5-dev \
        ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# sip 6.8.3：pywpsrpc 2.4.0 兼容区间（sip 6.15+ 改 API 编译崩、sip 6.5.x 不支持 Py3.11+ ABI）
RUN pip3 config set global.index-url https://mirrors.aliyun.com/pypi/simple/ && \
    pip3 install --no-cache-dir --break-system-packages sip==6.8.3

# --- pywpsrpc 2.4.0 源码（含 wpsrpc-sdk 子模块头文件，打包自 timxx/pywpsrpc v2.4.0）---
COPY pywpsrpc-2.4.0-src.tar.gz /tmp/
RUN cd /tmp && tar xzf pywpsrpc-2.4.0-src.tar.gz && mv pywpsrpc-pack pywpsrpc-full

# --- WPS 12 SDK 库：librpc*_wpsqt.so（pywpsrpc 编译链接目标）---
COPY download_wps12.sh /tmp/download_wps12.sh
RUN chmod +x /tmp/download_wps12.sh \
    && if [ -n "${WPS_DEB_URL}" ]; then \
         curl -fL --retry 5 --retry-delay 3 -C - -o /tmp/wps-sdk.deb "${WPS_DEB_URL}"; \
       else \
         /tmp/download_wps12.sh /tmp/wps-sdk.deb; \
       fi \
    && dpkg-deb -x /tmp/wps-sdk.deb /tmp/wps-x \
    && mkdir -p /opt/kingsoft/wps-office/office6 \
    && cp /tmp/wps-x/opt/kingsoft/wps-office/office6/librpcwpsapi_wpsqt.so \
          /tmp/wps-x/opt/kingsoft/wps-office/office6/librpcwppapi_wpsqt.so \
          /tmp/wps-x/opt/kingsoft/wps-office/office6/librpcetapi_wpsqt.so \
          /opt/kingsoft/wps-office/office6/ \
    && ls -la /opt/kingsoft/wps-office/office6/librpc*wpsqt.so \
    && rm -f /tmp/wps-sdk.deb && rm -rf /tmp/wps-x

# --- 编译 pywpsrpc 2.4.0（sip-build 一条命令，自动链接 _wpsqt）---
WORKDIR /tmp/pywpsrpc-full
RUN sip-build 2>&1 | tail -3

# --- 安装到 Python 3.12 的 dist-packages ---
RUN SP=$(python3 -c 'import site; print(site.getsitepackages()[0])') \
    && mkdir -p $SP/pywpsrpc \
    && cp -r build/pywpsrpc/* $SP/pywpsrpc/ \
    && ls $SP/pywpsrpc/ \
    && ldd $SP/pywpsrpc/rpcwpsapi.so | grep librpc

# --- 编译两个 LD_PRELOAD 修复库 ---
COPY libexitfix.c libmqsim.c /tmp/
RUN gcc -shared -fPIC -O2 -o /tmp/libexitfix.so /tmp/libexitfix.c \
    && gcc -shared -fPIC -O2 -o /tmp/libmqsim2.so /tmp/libmqsim.c -lrt \
    && ls -la /tmp/libexitfix.so /tmp/libmqsim2.so

# ----------------------------------------------------------------------
# 阶段 2：运行时镜像
# ----------------------------------------------------------------------
FROM ubuntu:24.04

ARG WPS_DEB_URL=""
# 中文字体包（复用主镜像 Release 附件，GitHub 自家 CDN）
# 国内/受限网络可 --build-arg 覆盖为 ghfast.top 加速：
#   https://ghfast.top/https://github.com/xna00/wps-docker/releases/download/wps-11.1.0.9662/fonts.tar.xz
ARG FONTS_URL="https://github.com/xna00/wps-docker/releases/download/wps-11.1.0.9662/fonts.tar.xz"

ENV DEBIAN_FRONTEND=noninteractive

RUN sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' \
        /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true

# --- 运行时依赖（WPS 12 自带 Qt5/ffmpeg，系统依赖与 9662 同一套即可）---
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb x11-utils xdg-utils dbus dbus-x11 fluxbox \
        libqt5gui5 libqt5widgets5 libqt5core5a libqt5x11extras5 \
        libqt5dbus5 libqt5network5 libqt5printsupport5 libqt5svg5 libqt5xml5 \
        libglu1-mesa libgl1 libasound2t64 libxcb-icccm4 libxcb-image0 \
        libxcb-keysyms1 libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 \
        libxcb-xkb1 libxkbcommon-x11-0 libxcomposite1 libxcursor1 libxrandr2 \
        libxi6 libxtst6 libnss3 libgbm1 libxslt1.1 libsm6 libcups2 \
        libxrender1 libxext6 libbz2-1.0 libfreetype6 libglib2.0-0 \
        libtiff6 fontconfig poppler-utils python3 python3-pip ca-certificates curl \
        bsdmainutils \
    && rm -rf /var/lib/apt/lists/*

# --- HTTP 服务依赖（FastAPI + uvicorn）---
RUN pip3 install --no-cache-dir --break-system-packages -i https://mirrors.aliyun.com/pypi/simple/ \
        fastapi "uvicorn[standard]" python-multipart

# --- libtiff 兼容（WPS 需要 libtiff.so.5）---
RUN ln -sf /usr/lib/x86_64-linux-gnu/libtiff.so.6 /usr/lib/x86_64-linux-gnu/libtiff.so.5

# --- 安装 WPS 12（postinst 有 127 报错属已知，容忍：包文件已解包即可用）---
COPY download_wps12.sh /tmp/download_wps12.sh
RUN chmod +x /tmp/download_wps12.sh \
    && if [ -n "${WPS_DEB_URL}" ]; then \
         curl -fL --retry 5 --retry-delay 3 -C - -o /tmp/wps.deb "${WPS_DEB_URL}"; \
       else \
         /tmp/download_wps12.sh /tmp/wps.deb; \
       fi \
    && (dpkg -i /tmp/wps.deb || apt-get -f install -y || true) \
    && rm -f /tmp/wps.deb \
    && dpkg -l | grep wps-office || true

# --- 字体安装（与主镜像共用 fonts_setup.sh，逻辑见该脚本注释）---
COPY fonts_setup.sh /tmp/fonts_setup.sh
RUN bash /tmp/fonts_setup.sh "${FONTS_URL}" && rm -f /tmp/fonts_setup.sh

# --- 屏蔽 WPS 更新服务器 ---
RUN sed -i 's|Address0=.*|Address0=http://127.0.0.1/blocked|' \
        /opt/kingsoft/wps-office/office6/cfgs/setup.cfg

# --- Office.conf：接受 EULA + 多组件模式 + 关闭首装/自动重启 ---
RUN mkdir -p /root/.config/Kingsoft && cat > /root/.config/Kingsoft/Office.conf <<'EOF'
[General]
AcceptedEULA=true
languages=zh_CN
FirstRun=false
UpdateMode=manual
CloudServiceEnabled=false

[6.0]
common\AcceptedEULA=true
common\newInstall=false
common\DefaultLanguage=2052
common\Local\UILanguage=2052
common\PromeWindowCount=40
common\loginSafeVersion=true
wpsoffice\Application%20Settings\AppComponentMode=prome_independ
wpsoffice\Application%20Settings\AppComponentModeInstall=prome_independ
EOF

# --- -multiply 多组件 RPC 激活（12 的脚本默认注释，需启用）---
RUN sed -i 's|#gOptExt=-multiply|gOptExt=-multiply|' /usr/bin/wps /usr/bin/wpp /usr/bin/et

# --- 假 gsettings（SDK 的 tablet-mode 探测需要成功返回）---
RUN cat > /usr/local/bin/gsettings <<'EOF'
#!/bin/bash
if [ "$1" = "get" ]; then echo "false"; exit 0; fi
if [ "$1" = "set" ]; then exit 0; fi
exit 0
EOF
RUN chmod +x /usr/local/bin/gsettings

# --- 拷贝 pywpsrpc + 修复库 + 转换脚本（与主镜像共用）---
COPY --from=builder /usr/local/lib/python3.12/dist-packages/pywpsrpc /usr/local/lib/python3.12/dist-packages/pywpsrpc
COPY --from=builder /tmp/libexitfix.so /tmp/libmqsim2.so /opt/wpsrpc-fix/
COPY convert_docx2pdf.py entrypoint.sh http_server.py /opt/wpsrpc-rpc/
COPY tests/e2e_test.sh /opt/wpsrpc-rpc/tests/e2e_test.sh
RUN chmod +x /opt/wpsrpc-rpc/entrypoint.sh /opt/wpsrpc-rpc/tests/e2e_test.sh

# --- 默认工作区 ---
RUN mkdir -p /data
WORKDIR /data

# HTTP 服务端口（MODE=api 时使用）
EXPOSE 8080

ENTRYPOINT ["/opt/wpsrpc-rpc/entrypoint.sh"]
